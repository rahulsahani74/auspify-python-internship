# Optional External LLM Integration Settings
# -------------------------------------------------------------
# By default, the AI Chatbot runs 100% offline using its local
# built-in Natural Language Processing (NLP) & TF-IDF similarity engine.
#
# If you wish to route conversational queries through an external OpenAI-compatible
# LLM (e.g., OpenAI, OpenRouter, Groq, Ollama), configure the settings below:

# API Key for OpenAI or compatible provider (Never commit real keys to Git!)
CHATBOT_API_KEY=your_api_key_here

# Base URL for API (defaults to OpenAI if left blank; use OpenRouter or Groq endpoints if needed)
# Examples:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   https://api.groq.com/openai/v1
#   http://localhost:11434/v1 (Local Ollama)
CHATBOT_API_BASE=https://api.openai.com/v1

# Target Model identifier
CHATBOT_MODEL=gpt-4o-mini

# Request timeout in seconds
CHATBOT_TIMEOUT_SECONDS=10
